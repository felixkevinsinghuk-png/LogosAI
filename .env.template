# RhemaLight AI — Environment Configuration
# Copy this file to .env and fill in the values

# ── Supabase Credentials ──────────────────────────────────────────────────────
# Find these in your Supabase Dashboard
# Project Settings -> API
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Project Settings -> API -> JWT Settings (Secret)
SUPABASE_JWT_SECRET="your-jwt-secret-here"

# ── AI Model Settings ─────────────────────────────────────────────────────────
# "mlx" is native Apple Silicon. Use "llama.cpp" otherwise depending on library.
LLM_BACKEND="mlx"
# Path (HuggingFace repo or local path) for the Mistral model
LLM_MODEL_PATH="mlx-community/Mistral-7B-Instruct-v0.2-4bit"

# ── Sub-systems configuration ──────────────────────────────────────────────────
# Directory to store the Chroma vector DB
CHROMA_PERSIST_DIR="./embeddings"
# Directory containing Local Bible JSON
SCRIPTURE_DATA_PATH="./database/bible_data"

# Frontend origin (for CORS)
FRONTEND_URL="http://localhost:8000"
